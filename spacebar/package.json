{
  "name": "spacebar",
  "version": "0.1.0",
  "private": true,
  "description": "An AI code editor built around free models, with ensembles that combine them.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "desktop": "vite build && npx --yes electron@33.2.1 electron/main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
